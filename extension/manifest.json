{
  "manifest_version": 3,
  "name": "Islandbar - pedidos do iFood",
  "short_name": "Islandbar iFood",
  "description": "Mostra na Islandbar o andamento do seu pedido do iFood (com qualquer página do iFood aberta).",
  "version": "1.3",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.ifood.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ifood.com.br/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.ifood.com.br/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Islandbar - pedidos do iFood",
    "default_popup": "popup.html"
  }
}
